    attr_reader magnet_uri: String?
    attr_reader total_size: Integer?
    attr_reader piece_length: Integer?
    attr_reader file_count: Integer?
    attr_reader files: Array[TorrentFile]?
    attr_reader peers: Array[TorrentPeer]?
    attr_reader timestamp: Time?
    def self.new: (?info_hash: String?, ?name: String?, ?magnet_uri: String?, ?total_size: Integer?, ?piece_length: Integer?, ?file_count: Integer?, ?files: Array[TorrentFile]?, ?peers: Array[TorrentPeer]?, ?timestamp: Time?) -> instance
    def initialize: (?info_hash: String?, ?name: String?, ?magnet_uri: String?, ?total_size: Integer?, ?piece_length: Integer?, ?file_count: Integer?, ?files: Array[TorrentFile]?, ?peers: Array[TorrentPeer]?, ?timestamp: Time?) -> void
    def with: (?info_hash: String?, ?name: String?, ?magnet_uri: String?, ?total_size: Integer?, ?piece_length: Integer?, ?file_count: Integer?, ?files: Array[TorrentFile]?, ?peers: Array[TorrentPeer]?, ?timestamp: Time?) -> instance
  end

  class TorrentFile < Data
    attr_reader path: String?
    attr_reader length: Integer?
    def self.new: (?path: String?, ?length: Integer?) -> instance
    def initialize: (?path: String?, ?length: Integer?) -> void
    def with: (?path: String?, ?length: Integer?) -> instance
  end

  class TorrentPeer < Data
    attr_reader ip: String?
    attr_reader port: Integer?
    attr_reader source: String?
    attr_reader encrypted: bool?
    def self.new: (?ip: String?, ?port: Integer?, ?source: String?, ?encrypted: bool?) -> instance
    def initialize: (?ip: String?, ?port: Integer?, ?source: String?, ?encrypted: bool?) -> void
    def with: (?ip: String?, ?port: Integer?, ?source: String?, ?encrypted: bool?) -> instance
  end

  class UniqueIPs < Data
    attr_reader value_24h: Integer
    attr_reader value_30d: Integer
    attr_reader sparkline_24h: Array[Integer]
    def self.new: (value_24h: Integer, value_30d: Integer, sparkline_24h: Array[Integer]) -> instance
    def initialize: (value_24h: Integer, value_30d: Integer, sparkline_24h: Array[Integer]) -> void
    def with: (?value_24h: Integer, ?value_30d: Integer, ?sparkline_24h: Array[Integer]) -> instance
  end
end
